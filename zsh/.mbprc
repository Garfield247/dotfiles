# 从 ~/.zshrc 加载的个人 shell 设置。

# 对 PATH 条目去重，并保持原有顺序。
typeset -U path PATH

# -----------------
# Homebrew 和工具
# -----------------

export HOMEBREW_BOTTLE_DOMAIN="https://mirrors.ustc.edu.cn/homebrew-bottles"
export HOMEBREW_NO_AUTO_UPDATE="true"

if command -v pyenv >/dev/null 2>&1; then
  export PYENV_ROOT="${HOME}/.pyenv"
  path=("${PYENV_ROOT}/bin" $path)
  eval "$(pyenv init -)"
  eval "$(pyenv virtualenv-init -)"
fi
export PYTHON_CONFIGURE_OPTS="--enable-framework"

for dir in \
  "${HOME}/Documents/go/bin" \
  "${HOME}/Documents/go" \
  "/usr/local/opt/icu4c/bin" \
  "/usr/local/opt/icu4c/sbin" \
  "/usr/local/opt/curl/bin" \
  "/usr/local/sbin"
do
  [[ -d "${dir}" ]] && path+=("${dir}")
done
unset dir

if [[ -r /opt/homebrew/etc/profile.d/autojump.sh ]]; then
  source /opt/homebrew/etc/profile.d/autojump.sh
elif command -v brew >/dev/null 2>&1; then
  autojump_sh="$(brew --prefix)/etc/profile.d/autojump.sh"
  [[ -r "${autojump_sh}" ]] && source "${autojump_sh}"
  unset autojump_sh
fi

# ---------------------
# 语言环境
# ---------------------

export GOPATH="${HOME}/Documents/go"
export GOBIN="${GOPATH}/bin"
export GOPROXY="https://goproxy.cn,direct"

# ----------------
# 编辑器默认设置
# ----------------

export VIMRC="${HOME}/.vimrc"
export EDITOR="nvim"

alias vi="vim"
alias vim="nvim"
alias nv="nvim"

# -------------
# Shell 别名
# -------------

alias ra="ranger"
alias lgt="lazygit"

alias py="python"
alias py2="python2"
alias py3="python3"
alias ipy="ipython"

alias tre="tree -N"
alias jptn="jupyter notebook --notebook-dir=${HOME}/Documents/jupyter_home"

# Git 别名
alias gst="git status -sb"
alias glg="git log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit"
alias ga="git add"
alias gcm="git cz"
alias gps="git push"
alias gpl="git pull"

# 应用启动别名
alias subl="open -a /Applications/Sublime\\ Text.app"
alias vscode="open -a /Applications/Visual\\ Studio\\ Code.app"
alias eclipse="open -a /Applications/Eclipse.app"
alias idea="open -a /Applications/IntelliJ\\ IDEA.app"
alias pycharm="open -a /Applications/PyCharm.app"
alias goland="open -a /Applications/GoLand.app"
alias typora="open -a /Applications/Typora.app"
alias chrome="open -a /Applications/Google\\ Chrome.app"

# thefuck
alias f="fuck"

# --------------------
# 敏感信息和本地配置
# --------------------

# 将机器相关配置或敏感环境变量放到 ~/.mbprc.local，
# 这样这个文件更安全，也更容易维护。
[[ -r ${HOME}/.mbprc.local ]] && source ${HOME}/.mbprc.local
