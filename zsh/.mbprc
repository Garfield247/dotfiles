# 从 ~/.zshrc 加载的个人 shell 设置。

# 对 PATH 条目去重，并保持原有顺序。
typeset -U path PATH

# -----------------
# Homebrew 和工具
# -----------------

export HOMEBREW_BOTTLE_DOMAIN="https://mirrors.ustc.edu.cn/homebrew-bottles"
export HOMEBREW_NO_AUTO_UPDATE="true"

if command -v pyenv >/dev/null 2>&1; then
  export PYENV_ROOT="${HOME}/.pyenv"
  path=("${PYENV_ROOT}/bin" $path)
  eval "$(pyenv init -)"
  if pyenv commands 2>/dev/null | grep -qx "virtualenv-init"; then
    eval "$(pyenv virtualenv-init -)"
  fi
fi
export PYTHON_CONFIGURE_OPTS="--enable-framework"

for dir in \
  "${HOME}/Documents/go/bin" \
  "${HOME}/Documents/go" \
  "/usr/local/opt/icu4c/bin" \
  "/usr/local/opt/icu4c/sbin" \
  "/usr/local/opt/curl/bin" \
  "/usr/local/bin" \
  "/usr/local/sbin" \
  "${HOME}/.local/bin"
do
  [[ -d "${dir}" ]] && path+=("${dir}")
done
unset dir

# ---------------------
# 目录快速跳转 (zsh-z)
# ---------------------
alias j='z'
compdef _zshz j 2>/dev/null || true


# ---------------------
# 语言环境
# ---------------------

export GOPATH="${HOME}/Documents/go"
export GOBIN="${GOPATH}/bin"
export GOPROXY="https://goproxy.cn,direct"

# ----------------
# 编辑器默认设置
# ----------------

export VIMRC="${HOME}/.vimrc"
export EDITOR="nvim"

alias vi="vim"
alias vim="nvim"
alias nv="nvim"

# -------------
# Shell 别名
# -------------

alias ll="ls -lh"
alias la="ls -lah"
alias l="ls -lh"
alias ..="cd .."
alias ...="cd ../.."
alias grep="grep --color=auto"

alias ra="ranger"
alias lgt="lazygit"
alias ldk="lazydocker"

alias py="python"
alias py2="python2"
alias py3="python3"
alias ipy="ipython"

alias tre="tree -N"
alias jptn="jupyter notebook --notebook-dir=${HOME}/Documents/jupyter_home"

# Git 别名
alias gst="git status -sb"
alias glg="git log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit"
alias ga="git add"
alias gcm="git cz"
alias gps="git push"
alias gpl="git pull"

# 应用启动别名
alias subl="open -a /Applications/Sublime\\ Text.app"
alias vscode="open -a /Applications/Visual\\ Studio\\ Code.app"
alias eclipse="open -a /Applications/Eclipse.app"
alias idea="open -a /Applications/IntelliJ\\ IDEA.app"
alias pycharm="open -a /Applications/PyCharm.app"
alias goland="open -a /Applications/GoLand.app"
alias typora="open -a /Applications/Typora.app"
alias chrome="open -a /Applications/Google\\ Chrome.app"

# thefuck
alias f="fuck"

# -----------------------------
# Gemini AI Agent 配置与双机同步
# -----------------------------

alias cdgemini="cd ${HOME}/.gemini"
alias cdai="cd ${HOME}/Documents/ai"
alias cdskills="cd ${HOME}/Documents/ai/skills"
alias gemini-st="git -C ${HOME}/.gemini status -sb"
alias gemini-pull="git -C ${HOME}/.gemini pull --rebase origin main"
alias gemini-push='git -C ${HOME}/.gemini add . && (git -C ${HOME}/.gemini diff --cached --quiet || git -C ${HOME}/.gemini commit -m "chore: 同步配置 $(date +"%Y-%m-%d %H:%M:%S")") && git -C ${HOME}/.gemini push origin main'

gemini-sync() {
  local gemini_dir="${HOME}/.gemini"
  if [[ ! -d "${gemini_dir}/.git" ]]; then
    printf "\033[31m[Gemini Sync]\033[0m %s 尚未初始化 git 仓库\n" "${gemini_dir}"
    return 1
  fi
  printf "\033[36m[Gemini Sync]\033[0m 正在拉取远端配置 (pull --rebase)...\n"
  git -C "${gemini_dir}" pull --rebase origin main || {
    printf "\033[31m[Gemini Sync]\033[0m 拉取遇到冲突，请先手动排查处理！\n"
    return 1
  }
  git -C "${gemini_dir}" add .
  if ! git -C "${gemini_dir}" diff --cached --quiet; then
    local commit_msg="chore: 同步配置 ($(date +'%Y-%m-%d %H:%M:%S'))"
    git -C "${gemini_dir}" commit -m "${commit_msg}"
    printf "\033[32m[Gemini Sync]\033[0m 本地变更已提交: %s\n" "${commit_msg}"
  else
    printf "\033[33m[Gemini Sync]\033[0m 本地无新文件变更\n"
  fi
  printf "\033[36m[Gemini Sync]\033[0m 正在推送到 GitHub 远端...\n"
  git -C "${gemini_dir}" push origin main && printf "\033[32m[Gemini Sync]\033[0m 双机配置同步完成！\n"
}

# --------------------
# 敏感信息和本地配置
# --------------------

# 将机器相关配置或敏感环境变量放到 ~/.mbprc.local，
# 这样这个文件更安全，也更容易维护。
[[ -r ${HOME}/.mbprc.local ]] && source ${HOME}/.mbprc.local
